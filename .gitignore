# Секреты и учётные данные — НИКОГДА не коммитить
.env
.env.*
!.env.example
*.local.*
*credentials*
*secret*

# Дампы облака Anthbot (содержат серийники, координаты участка, токены)
dumps/
*.dump.json

# Журнал решений — рабочие записи с деталями конкретного хаба, наружу не идёт
JOURNAL.md

# Разведка облака наружу не идёт: эти скрипты ходят в настоящее облако Anthbot под
# учётными данными владельца косилки и печатают сырое состояние — серийник, координаты
# участка, идентификатор симки. Сборка (hubbuild) и проверка имён (namecheck) в репозитории
# есть: без них проект не установить.
tools/probe.mjs
tools/wssprobe.mjs
probe-out/

# Среда
node_modules/
.DS_Store
*.log
.claude/

# Сгенерированные файлы для импорта в хаб
build/
