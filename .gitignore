# Секреты и учётные данные — НИКОГДА не коммитить
.env
.env.*
!.env.example
*.local.*
*credentials*
*secret*

# Дампы облака Anthbot (содержат серийники, координаты участка, токены)
dumps/
*.dump.json

# Журнал решений — рабочие записи с деталями конкретного хаба, наружу не идёт
JOURNAL.md

# Разведка облака наружу не идёт: probe печатает сырое состояние — серийник, координаты
# участка, идентификатор симки — и кладёт полный дамп на диск. Остальные инструменты
# в репозитории есть: hubbuild и namecheck нужны для установки, wssprobe печатает только
# вердикты и длины пакетов, без содержимого.
tools/probe.mjs
probe-out/

# Среда
node_modules/
.DS_Store
*.log
.claude/

# Сгенерированные файлы для импорта в хаб
build/
